# Server
PORT=3000
NODE_ENV=development

# Database (Railway provides this automatically)
DATABASE_URL="postgresql://user:password@localhost:5432/3sc_platform?schema=public"

# Redis (for caching, sessions, rate limiting)
REDIS_URL="redis://localhost:6379"

# JWT Secrets - generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# CORS Origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Cookie SameSite policy: lax | strict | none
# Use 'none' for cross-origin frontends (requires HTTPS). Use 'lax' for same-origin.
COOKIE_SAME_SITE="lax"

# AI Providers (add multiple for cost/quality routing)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."

# Object Storage (Cloudflare R2 or AWS S3)
R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="3sc-attachments"
R2_PUBLIC_URL="https://cdn.yourdomain.com"

# Email (Brevo — free tier: 300/day)
BREVO_API_KEY="dummy-..."
BREVO_SMTP_KEY="dummy-..."
BREVO_SMTP_USER="your-brevo-account@email.com"
EMAIL_FROM="noreply@brevosend.com"
EMAIL_FROM_NAME="3SC Platform"

# Error Tracking (Sentry - free tier: 5k errors/mo)
SENTRY_DSN="https://..."
